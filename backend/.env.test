# Test environment configuration — Phase 10 (API Testing).
#
# None of these are real secrets: this file is used only against a local,
# throwaway test database (a second database inside the same local Postgres
# container used for development, never the dev database itself) and is
# safe to commit. Never point TEST_DATABASE_URL at a shared or production
# database — the test suite truncates every table before each test.

NODE_ENV=test
PORT=4001
CORS_ORIGIN=http://localhost:5173

DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_management_test

JWT_SECRET=test-only-secret-do-not-use-in-any-real-environment-0123456789
JWT_EXPIRES_IN=1h

ADMINISTRATION_OFFICE_NAME=Administration Office
ADMIN_NAME=Test Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=TestAdmin123!
BCRYPT_SALT_ROUNDS=4
