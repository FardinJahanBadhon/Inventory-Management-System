# Server
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Database (must match the values in the root .env used by docker-compose)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/inventory_management

# JWT — used by src/lib/jwt.ts (signing/verifying happens starting Phase 5's
# login endpoint, but the secret is validated at startup from Phase 4 on).
# Generate a real value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=8h

# Administration Office bootstrap — consumed by `npm run db:seed` (prisma/seed.ts).
# ADMIN_PASSWORD has no default; the seed fails fast if it is not set.
ADMINISTRATION_OFFICE_NAME=Administration Office
ADMIN_NAME=System Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
BCRYPT_SALT_ROUNDS=10
